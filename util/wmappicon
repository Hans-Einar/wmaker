#!/bin/sh
set -eu

helper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

usage() {
    cat <<'EOF'
Usage:
  wmappicon FILE.desktop
  wmappicon --command COMMAND --icon FILE_OR_NAME [--name NAME]
  wmappicon --save-icon-state
  wmappicon -s
  wmappicon --help

Create a Window Maker Clip icon from a .desktop file without starting the
application. The icon is omnipresent.

Options:
  --command COMMAND     Create a button that runs COMMAND on every activation
  --icon FILE_OR_NAME   Icon for a command button
  --name NAME           Stable name for the command button (default: COMMAND)
  -s, --save-icon-state  Save Dock/Clip icon positions to WMState
  -h, --help             Show this help
EOF
}

mode=application
if [ "${1:-}" = "--command" ]; then
    mode=command
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    command=$2
    name=$command
    icon=
    shift 2
    while [ "$#" -gt 0 ]; do
        [ "$#" -ge 2 ] || { usage >&2; exit 2; }
        case "$1" in
            --icon) icon=$2 ;;
            --name) name=$2 ;;
            *) echo "wmappicon: unknown option: $1" >&2; exit 2 ;;
        esac
        shift 2
    done
    [ -n "$command" ] && [ -n "$icon" ] && [ -n "$name" ] || { usage >&2; exit 2; }
    # Reserve an identity unrelated to the controlled application's WM_CLASS.
    window_instance=command_$(printf '%s' "$name" | cksum | awk '{print $1}')
    window_class=WMCommandButton
else
    case "${1:-}" in
        -h|--help) usage; exit 0 ;;
        -s|--save-icon-state) exec "$helper_dir/wmappicon-ipc" --save ;;
        ''|-*) usage >&2; exit 2 ;;
    esac
    [ "$#" -eq 1 ] && [ -r "$1" ] || { usage >&2; exit 2; }
    desktop=$1
    get_key() {
        awk -F= -v key="$1" '
            /^\[Desktop Entry\]$/ { entry=1; next }
            /^\[/ { entry=0 }
            entry && $1 == key {sub(/^[^=]*=/, ""); print; exit}
        ' "$desktop"
    }
    name=$(get_key Name)
    exec_line=$(get_key Exec)
    icon=$(get_key Icon)
    [ -n "$name" ] || name=$(basename "$desktop" .desktop)
    [ -n "$exec_line" ] || { echo "wmappicon: missing Exec in $desktop" >&2; exit 1; }
    command=$(printf '%s\n' "$exec_line" | sed -E 's/%[fFuUdDnNickvm]//g; s/[[:space:]]+$//')
    window_instance=$(get_key StartupWMClass)
    window_class=$(get_key X-WindowClass)
    if [ -z "$window_class" ] && [ "$command" = "chatgpt" ]; then
        window_class=Chatgpt
    fi
    if [ -z "$window_instance" ] && [ -z "$window_class" ]; then
        window_instance=$(basename "$desktop" .desktop | tr -c '[:alnum:]_' '_' | sed 's/_$//')
    fi
fi

resolve_icon() {
    case "$icon" in
        /*) [ -r "$icon" ] || return 1; printf '%s\n' "$icon"; return ;;
    esac
    for candidate in \
        "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps/$icon.svg" \
        "/usr/share/pixmaps/$icon.png" \
        "/usr/share/pixmaps/$icon.svg" \
        "/usr/share/icons/hicolor/48x48/apps/$icon.png" \
        "/usr/share/icons/hicolor/64x64/apps/$icon.png" \
        "/usr/share/icons/hicolor/128x128/apps/$icon.png" \
        "/usr/share/icons/hicolor/scalable/apps/$icon.svg"; do
        [ -r "$candidate" ] && { printf '%s\n' "$candidate"; return; }
    done
    find /usr/share/icons -type f \( -name "$icon.png" -o -name "$icon.svg" \) -readable -print -quit 2>/dev/null
}

icon_file=$(resolve_icon)
[ -n "$icon_file" ] || { echo "wmappicon: fant ikke ikon '$icon'" >&2; exit 1; }
# The IPC is newline-delimited; reject fields that would alter its structure.
for field in "$name" "$window_instance" "$window_class" "$command" "$icon_file"; do
    case "$field" in
        *'
'*) echo "wmappicon: multiline arguments are not supported" >&2; exit 2 ;;
    esac
done
payload=$(printf '%s\n%s\n%s\n%s\n%s\n%s' \
    "$name" "$window_instance" "$window_class" "$command" "$icon_file" "$mode")
exec "$helper_dir/wmappicon-ipc" "$payload"
